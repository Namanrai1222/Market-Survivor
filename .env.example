# Where the dev JSON store keeps careers (default: apps/web/.data). Replaced by Postgres later.
MS_DATA_DIR=

# Key that seals each career's seed at rest (AES-256-GCM) and seeds the shared Daily Challenge.
# Required in production; dev falls back to a fixed key. Any long random string, e.g. `openssl rand -hex 32`.
MS_SEED_KEY=
